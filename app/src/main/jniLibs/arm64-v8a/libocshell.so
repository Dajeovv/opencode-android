#!/system/bin/sh
# Trampolin estable dentro del directorio nativo del APK (unica ruta
# ejecutable sin root). El servidor lo usa como SHELL; el trabajo real lo
# hace el envoltorio generado por CommandResolver en el prefijo de la app.
# Busca oc-shell en las rutas conocidas (release y debug) porque el
# entorno del agente no siempre tiene TERMUX_HOME u OPENCODE_WRAPPER.
OC_SHELL=""
for candidate in "$OPENCODE_WRAPPER" \
    /data/user/0/com.opencode.android/files/usr/bin/oc-shell \
    /data/data/com.opencode.android/files/usr/bin/oc-shell \
    /data/user/0/com.opencode.android.debug/files/usr/bin/oc-shell \
    /data/data/com.opencode.android.debug/files/usr/bin/oc-shell; do
  if [ -n "$candidate" ] && [ -f "$candidate" ]; then
    OC_SHELL="$candidate"
    break
  fi
done
if [ -n "$OC_SHELL" ]; then
  exec /system/bin/sh "$OC_SHELL" "$@"
fi
exec /system/bin/sh "$@"
"